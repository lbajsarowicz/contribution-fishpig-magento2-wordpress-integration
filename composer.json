{
    "name": "fishpig/magento2-wordpress-integration",
    "description": "Securely integrate WordPress and Magento 2.",
    "version": "3.33.1",
    "require": {
        "php": ">=7.4",
        "magento/framework": "*",
        "magento/module-config": "*",
        "magento/module-store": "*",
        "magento/module-sitemap": "^100.3"
    },
    "suggest": {
        "fishpig/magento2-wordpress-integration-yoastseo": "^3.0"
    },
    "type": "magento2-module",
    "autoload": {
    	"files": [
            "registration.php"
    	],
    	"psr-4": {
            "FishPig\\WordPress\\": ""
    	}
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
